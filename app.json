{
  "expo": {
    "name": "MonSuiviRando",
    "slug": "MonSuiviRando",
    "owner": "sahminacera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "jsc",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autorisez MonSuiviRando à accéder à votre caméra",
          "microphonePermission": "Autorisez MonSuiviRando à accéder à votre micro",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
